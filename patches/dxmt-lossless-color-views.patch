Retain lossless compression eligibility on sRGB-only colour typeless families.
Adapted from playportdev/playport patches/dxmt/0009 at commit 412de5f.
Playport authors, GPL-3.0; retain the additional depth-bind and UAV guards here.

--- a/src/d3d11/d3d11_resource_helper.cpp
+++ b/src/d3d11/d3d11_resource_helper.cpp
@@ -4,6 +4,7 @@
 #include "d3d11_resource.hpp"
 #include "d3d11_1.h"
 #include "util_math.hpp"
+#include "util_env.hpp"
 
 namespace dxmt {
 
@@ -369,8 +370,21 @@
   }
 
   if (metal_format.Flag & MTL_DXGI_FORMAT_TYPELESS) {
-    // well this is necessary for passing validation layer
-    metal_usage |= WMTTextureUsagePixelFormatView;
+    /* Adapted from Playport's DXMT 0009 with narrower compatibility rules.
+     * Metal validation rejects e.g. RGBA8 UNORM->SNORM without PFV, despite
+     * the unchanged component sizes. Keep it on numeric typeless families.
+     * BGRA/BGRX typeless families only expose linear/sRGB (plus X swizzle),
+     * where PFV is unnecessary and would disable lossless compression.
+     * Depth, BC and UAV resources retain the preceding allocation policy.
+     * The explicit escape hatch also restores it for BGRA/BGRX. */
+    static const bool always_pfv = env::getEnvVar("DXMT_TYPELESS_PFV") == "1";
+    const bool srgb_only_family = Format == DXGI_FORMAT_B8G8R8A8_TYPELESS ||
+                                  Format == DXGI_FORMAT_B8G8R8X8_TYPELESS;
+    if (always_pfv || !srgb_only_family ||
+        (BindFlags & (D3D11_BIND_DEPTH_STENCIL | D3D11_BIND_UNORDERED_ACCESS)) ||
+        (metal_format.Flag & (MTL_DXGI_FORMAT_DEPTH_PLANER | MTL_DXGI_FORMAT_STENCIL_PLANER |
+                              MTL_DXGI_FORMAT_BC)))
+      metal_usage |= WMTTextureUsagePixelFormatView;
   }
 
   if (metal_format.Flag & (MTL_DXGI_FORMAT_DEPTH_PLANER | MTL_DXGI_FORMAT_STENCIL_PLANER)) {
