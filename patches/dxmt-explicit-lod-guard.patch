--- a/src/airconv/airconv_context.cpp
+++ b/src/airconv/airconv_context.cpp
@@ -12,6 +12,8 @@
 #include "llvm/Passes/StandardInstrumentations.h"
 #include "llvm/Transforms/Scalar/LowerExpectIntrinsic.h"
 #include "llvm/Transforms/Scalar/SimplifyCFG.h"
+#include "llvm/Transforms/Scalar/LoopRotation.h"
+#include "llvm/Transforms/Scalar/Sink.h"
 #include "llvm/Transforms/Scalar/SROA.h"
 #include "llvm/Transforms/Scalar/EarlyCSE.h"
 #include "llvm/Transforms/IPO/AlwaysInliner.h"
@@ -144,6 +146,13 @@ runOptimizationPasses(llvm::Module &M) {
 
     GlobalCleanupPM.addPass(air::Lower16BitTexReadPass());
 
+    // Expose the zero-trip guard before sinking invariant work. In compute
+    // shaders this keeps explicit-LOD texture samples out of empty lighting
+    // loops instead of paying for them for every voxel. Implicit-LOD calls
+    // and barriers remain convergent and cannot acquire new control guards.
+    GlobalCleanupPM.addPass(createFunctionToLoopPassAdaptor(LoopRotatePass()));
+    GlobalCleanupPM.addPass(SinkingPass());
+
     MPM.addPass(createModuleToFunctionPassAdaptor(std::move(GlobalCleanupPM), true /* ? */));
   }
 
@@ -198,4 +207,4 @@ linkTessellation(llvm::Module &M) {
   linkShader(M, air_tessellation);
 }
 
