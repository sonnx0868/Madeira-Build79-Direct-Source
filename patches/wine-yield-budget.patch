+    long long minimum_calls = madeira_cfg_int( "yield-streak", 0 );
+    /* Keep explicit overrides bounded; a count is an additional gate, never
+     * permission to sleep in a short handoff before the elapsed budget. */
+    ios_yield_sleep_us = sleep_us < 0 ? 0 : sleep_us > 1000000 ? 1000000 : sleep_us;
+    ios_yield_min_calls = minimum_calls < 0 ? 0 : minimum_calls > UINT_MAX ? UINT_MAX : minimum_calls;
+    fprintf( stderr, "[yield-budget-v2] sustained polling only: budget=2000us gap=100us sleep=%uus min_calls=%u; darwin-yield-v1 no priority depression\n",
