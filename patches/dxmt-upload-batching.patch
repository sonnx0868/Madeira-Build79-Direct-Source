+// MADEIRA_UPLOAD_BATCHING_HELPERS_BEGIN
+static madeira::UploadBatchKind
+classifyUploadBatchPass(EncoderData *pass) {
+  using Kind = madeira::UploadBatchKind;
+  if (pass->type == EncoderType::Null)
+    return Kind::Empty;
+  wmtcmd_base *command;
+  Kind kind;
+  if (pass->type == EncoderType::Blit) {
+    command = static_cast<wmtcmd_base *>(static_cast<BlitEncoderData *>(pass)->cmd_head.next.get());
+    kind = Kind::Copy;
+  } else if (pass->type == EncoderType::Compute) {
+    command = static_cast<wmtcmd_base *>(static_cast<ComputeEncoderData *>(pass)->cmd_head.next.get());
+    kind = Kind::Compute;
+  } else {
+    // Includes render/visibility queries, event/timestamp signals, presentation,
+    // clear/resolve and upscaling. Their order is unchanged.
+    return Kind::Barrier;
+  }
+  if (!command)
+    return Kind::Barrier;
+  unsigned commands = 0;
+  for (; command; command = static_cast<wmtcmd_base *>(command->next.get())) {
+    if (++commands > 64)
+      return Kind::Barrier;
+    if (kind == Kind::Copy) {
+      if (command->type != WMTBlitCommandCopyFromBufferToBuffer)
+        return Kind::Barrier;
+    } else if (command->type > WMTComputeCommandDispatchThreads) {
+      // Explicit fences and future command types require their own proof.
+      return Kind::Barrier;
+    }
+  }
+  return kind;
+}
+
+static void
+mergeUploadBatchPasses(EncoderData *earlier, EncoderData *later) {
+  auto target = static_cast<BlitEncoderData *>(earlier);
+  auto upload = static_cast<BlitEncoderData *>(later);
+  target->cmd_tail->next.set(upload->cmd_head.next.get());
+  target->cmd_tail = upload->cmd_tail;
+  target->buf_read.merge(upload->buf_read);
+  target->buf_write.merge(upload->buf_write);
+  target->tex_read.merge(upload->tex_read);
+  target->tex_write.merge(upload->tex_write);
+  upload->cmd_head.next.set(nullptr);
+  upload->cmd_tail = reinterpret_cast<wmtcmd_base *>(&upload->cmd_head);
+  // Command storage and resource references still belong to this submission's
+  // CPU arena and allocation tracker. Only the empty encoder record is retired.
+  upload->~BlitEncoderData();
+}
