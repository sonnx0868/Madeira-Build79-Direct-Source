+/* Called only by WGI's existing monitor thread, once at startup and on the
+ * bounded hotplug timeout. Manager callbacks run without provider_cs held. */
+void provider_sync_host( void )
+{
+    static struct provider *hosts[XUSER_MAX_COUNT];
+    struct provider *impl;
+    XINPUT_STATE state;
+    UINT i;
+
+    for (i = 0; i < XUSER_MAX_COUNT; ++i)
+    {
+        BOOL connected = NtUserGetGamepadState( i, NtUserGamepadOp_State, &state );
+        if (!!hosts[i] == !!connected) continue;
+        if (connected)
+        {
+            if (!(impl = calloc( 1, sizeof(*impl) ))) continue;
+            impl->IWineGameControllerProvider_iface.lpVtbl = &wine_provider_vtbl;
+            impl->IGameControllerProvider_iface.lpVtbl = &game_provider_vtbl;
+            impl->host = TRUE;
+            impl->host_connected = TRUE;
+            impl->host_index = i;
+            impl->device = INVALID_HANDLE_VALUE;
+            impl->ref = 1;
+            hosts[i] = impl;
+            manager_on_provider_created( &impl->IGameControllerProvider_iface );
+            ERR( "[wgi-host] host-gamepad-v1 slot=%u connected=1\n", i );
+        }
+        else
+        {
+            impl = hosts[i];
+            hosts[i] = NULL;
+            InterlockedExchange( &impl->host_connected, FALSE );
+            manager_on_provider_removed( &impl->IGameControllerProvider_iface );
+            IGameControllerProvider_Release( &impl->IGameControllerProvider_iface );
+            ERR( "[wgi-host] host-gamepad-v1 slot=%u connected=0\n", i );
+        }
+    }
+}
