+/* The host already merges touch and physical controllers into XInput slots.
+ * Modern Windows input clients enumerate WGI instead of polling XInput. Feed
+ * those same slots into Wine's existing Gamepad/RawGameController factories;
+ * no HID driver, keyboard emulation or second controller state is involved. */
+static double host_gamepad_axis( SHORT value )
+{
+    return (1. + (value < 0 ? value / 32768. : value / 32767.)) * .5;
+}
+
+static HRESULT host_gamepad_reading( UINT index, struct WineGameControllerState *out )
+{
+    static const WORD buttons[] = {0x1000, 0x2000, 0x4000, 0x8000, 0x100, 0x200, 0x20, 0x10, 0x40, 0x80};
+    XINPUT_STATE state;
+    WORD dpad;
+    UINT i;
+
+    memset( out, 0, sizeof(*out) );
+    if (!NtUserGetGamepadState( index, NtUserGamepadOp_State, &state ))
+        return HRESULT_FROM_WIN32( ERROR_DEVICE_NOT_CONNECTED );
+
+    /* Match the established axis contract consumed by gamepad_GetCurrentReading:
+     * [LY, LX, RY, RX, LT, RT]. Center is exactly .5, endpoints exactly 0/1. */
+    out->axes[0] = host_gamepad_axis( state.Gamepad.sThumbLY );
+    out->axes[1] = host_gamepad_axis( state.Gamepad.sThumbLX );
+    out->axes[2] = host_gamepad_axis( state.Gamepad.sThumbRY );
+    out->axes[3] = host_gamepad_axis( state.Gamepad.sThumbRX );
+    out->axes[4] = state.Gamepad.bLeftTrigger / 255.;
+    out->axes[5] = state.Gamepad.bRightTrigger / 255.;
+    for (i = 0; i < ARRAY_SIZE(buttons); ++i) out->buttons[i] = !!(state.Gamepad.wButtons & buttons[i]);
+    dpad = state.Gamepad.wButtons & 0xf;
+    /* Resolve impossible opposite pairs to neutral on that axis. */
+    if ((dpad & 3) == 3) dpad &= ~3;
+    if ((dpad & 12) == 12) dpad &= ~12;
+    switch (dpad)
+    {
+    case 1: out->switches[0] = GameControllerSwitchPosition_Up; break;
+    case 9: out->switches[0] = GameControllerSwitchPosition_UpRight; break;
+    case 8: out->switches[0] = GameControllerSwitchPosition_Right; break;
+    case 10: out->switches[0] = GameControllerSwitchPosition_DownRight; break;
+    case 2: out->switches[0] = GameControllerSwitchPosition_Down; break;
+    case 6: out->switches[0] = GameControllerSwitchPosition_DownLeft; break;
+    case 4: out->switches[0] = GameControllerSwitchPosition_Left; break;
+    case 5: out->switches[0] = GameControllerSwitchPosition_UpLeft; break;
+    default: break;
+    }
+    out->timestamp = GetTickCount64();
+    return S_OK;
+}
