+/* Physical RAM reserve budgeting follows the reviewed BCD fixes by bahacan16
+ * and Will Faust (644a354 / bb18171). A jetsam limit may exceed physical RAM. */
+static uint64_t madeira_ram_cap(void) {
+  static uint64_t cap;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+#if TARGET_OS_IOS
+    uint64_t physical = 0;
+    size_t size = sizeof physical;
+    long long reserve_mb = madeira_cfg_int("ram-reserve-mb", 1536);
+    if (reserve_mb > 0 && (uint64_t)reserve_mb <= (UINT64_MAX >> 20) &&
+        !sysctlbyname("hw.memsize", &physical, &size, NULL, 0) && size == sizeof physical &&
+        physical > ((uint64_t)reserve_mb << 20))
+      cap = physical - ((uint64_t)reserve_mb << 20);
+    fprintf(stderr, "[texture-memory-v1] physical=%lluMB reserve=%lldMB process-cap=%lluMB\n",
+            (unsigned long long)(physical >> 20), reserve_mb, (unsigned long long)(cap >> 20));
+#endif
+  });
+  return cap;
+}
+
+static uint64_t madeira_mem_limit(uint64_t footprint) {
+  return madeira_memory_limit((uint64_t)os_proc_available_memory(), footprint, madeira_ram_cap());
+}
+
+static uint64_t madeira_avail_memory(uint64_t footprint) {
+  return madeira_memory_available((uint64_t)os_proc_available_memory(), footprint, madeira_ram_cap());
+}
