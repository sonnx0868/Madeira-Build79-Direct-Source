Use a non-depressing Darwin yield and avoid yielding before nonzero timed sleeps.

--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -57,6 +57,10 @@
 #include <time.h>
 #ifdef __APPLE__
 # include <mach/mach_time.h>
+# ifdef WINE_IOS
+#  include <mach/mach.h>
+#  include <mach/thread_switch.h>
+# endif
 #endif
 #ifdef HAVE_KQUEUE
 # include <sys/event.h>
@@ -74,6 +78,10 @@
 #include "unix_private.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(sync);
+
+#ifdef WINE_IOS
+#include "../../../../build/ntdll-unix/ios_scheduler_yield.h"
+#endif
 
 HANDLE keyed_event = 0;
 int inproc_device_fd = -1;
@@ -3587,7 +3595,7 @@
             ios_ystreak = madeira_cfg_int( "yield-streak", 256 );
             ios_ysleep = madeira_cfg_int( "yield-sleep-us", 100 );
             if (ios_ysleep < 0) ios_ysleep = 0;
-            fprintf( stderr, "[sync-census] ml1124 adaptive yield: sleep %lld us after %lld back-to-back yields%s\n",
+            fprintf( stderr, "[sync-census] ml1124 adaptive yield: sleep %lld us after %lld back-to-back yields%s; darwin-yield-v1 no priority depression\n",
                      ios_ysleep, ios_ystreak, ios_ysleep ? "" : " (DISABLED)" );
         }
         if (now - ios_last_yield_ns < 2000000ull) ios_yield_streak++; else ios_yield_streak = 0;
@@ -3601,7 +3609,9 @@
         }
     }
 #endif
-#ifdef HAVE_SCHED_YIELD
+#if defined(WINE_IOS)
+    return ios_scheduler_yield();
+#elif defined(HAVE_SCHED_YIELD)
 #ifdef RUSAGE_THREAD
     struct rusage u1, u2;
     int ret;
@@ -3661,10 +3671,23 @@
             when = now.QuadPart - when;
         }
 
+#ifdef WINE_IOS
+        /* A timed sleep already parks the thread. sched_yield additionally
+         * depresses Darwin scheduling priority, potentially beyond the
+         * requested sleep. Only a zero timeout asks us to yield. */
+        if (!when) return NtYieldExecution();
+        {
+            static int announced;
+            if (!__atomic_load_n( &announced, __ATOMIC_RELAXED ) &&
+                !__atomic_exchange_n( &announced, 1, __ATOMIC_RELAXED ))
+                fprintf( stderr, "[timed-sleep-v1] nonzero sleeps park without a scheduler yield\n" );
+        }
+#else
         /* Note that we yield after establishing the desired timeout, but
            we only care about the result of the yield for zero timeouts */
         status = NtYieldExecution();
         if (!when) return status;
+#endif
 
         for (;;)
         {
