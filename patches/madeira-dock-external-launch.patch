+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright 2026 125hz
+ * Madeira Converter Exception: see LICENSE-EXCEPTION.md */
+#include "external.h"
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+
+bool sh_external_requested(void)
+{
+    wchar_t value[2];
+    return GetEnvironmentVariableW(L"MADEIRA_STEAM_HOST_EXTERNAL", value, 2) == 1 && value[0] == L'1';
+}
+
+static wchar_t program[32768], directory[32768], command[32768];
+
+bool sh_external_validate(void)
+{
+    wchar_t normalized[32768], arguments[32768];
+    DWORD size = GetEnvironmentVariableW(L"MADEIRA_STEAM_HOST_PROGRAM", program, 32768);
+    if (!size || size >= 32768 || size < 8 || program[0] != L'C' || program[1] != L':' ||
+        program[2] != L'\\' || wcschr(program, L'"') || wcschr(program, L'/') ||
+        _wcsicmp(program + size - 4, L".exe")) return false;
+    DWORD full = GetFullPathNameW(program, 32768, normalized, NULL);
+    if (!full || full >= 32768 || _wcsicmp(normalized, program)) return false;
+    DWORD attrs = GetFileAttributesW(program);
+    if (attrs == INVALID_FILE_ATTRIBUTES || (attrs & FILE_ATTRIBUTE_DIRECTORY)) return false;
+    wcscpy(directory, program);
+    wchar_t *last = wcsrchr(directory, L'\\');
+    if (!last || last == directory + 2) return false;
+    *last = 0;
+    SetLastError(ERROR_SUCCESS);
+    DWORD count = GetEnvironmentVariableW(L"MADEIRA_STEAM_HOST_ARGUMENTS", arguments, 32768);
+    if (count >= 32768 || (!count && GetLastError() != ERROR_SUCCESS &&
+                          GetLastError() != ERROR_ENVVAR_NOT_FOUND)) return false;
+    if (!count) arguments[0] = 0;
+    if ((size_t)size + count + (count ? 4 : 3) > 32768) return false;
+    command[0] = L'"';
+    memcpy(command + 1, program, size * sizeof(wchar_t));
+    command[size + 1] = L'"';
+    command[size + 2] = 0;
+    if (count) { command[size + 2] = L' '; wcscpy(command + size + 3, arguments); }
+    return true;
+}
+
+static bool omit(const wchar_t *entry)
+{
+    const wchar_t *keys[] = {L"SteamAppId=", L"SteamGameId=", L"SteamAppPath=",
+                            L"MADEIRA_STEAM_HOST_", L"MADEIRA_DOCK_AUTH_FILE="};
+    for (size_t i = 0; i < sizeof(keys)/sizeof(keys[0]); ++i)
+        if (!_wcsnicmp(entry, keys[i], wcslen(keys[i]))) return true;
+    return false;
+}
+static int compare_entries(const void *a, const void *b)
+{
+    return _wcsicmp(*(const wchar_t *const *)a, *(const wchar_t *const *)b);
+}
+static wchar_t *child_environment(uint32_t appid)
+{
+    wchar_t identity[2][48], path[32768];
+    _snwprintf(identity[0], 48, L"SteamAppId=%u", appid);
+    _snwprintf(identity[1], 48, L"SteamGameId=%u", appid);
+    if (wcslen(directory) + 14 >= 32768) return NULL;
+    wcscpy(path, L"SteamAppPath=");wcscat(path, directory);
+    wchar_t *parent = GetEnvironmentStringsW(), *out = NULL;
+    if (!parent) return NULL;
+    size_t entries = 3, units = 1;
+    for (const wchar_t *p = parent; *p; p += wcslen(p) + 1)
+        if (!omit(p)) ++entries;
+    const wchar_t **list = calloc(entries, sizeof(*list));
+    if (!list) goto done;
+    size_t at = 0;
+    for (const wchar_t *p = parent; *p; p += wcslen(p) + 1)
+        if (!omit(p)) list[at++] = p;
+    list[at++] = identity[0];list[at++] = identity[1];list[at++] = path;
+    qsort(list, entries, sizeof(*list), compare_entries);
+    for (size_t i = 0; i < entries; ++i) {
+        size_t n = wcslen(list[i]) + 1;
+        if (n > 32767 || units > 32767 - n) goto done;
+        units += n;
+    }
+    out = calloc(units, sizeof(wchar_t));
+    if (out) {
+        wchar_t *p = out;
+        for (size_t i = 0; i < entries; ++i) {
+            size_t n = wcslen(list[i]) + 1;memcpy(p, list[i], n * sizeof(wchar_t));p += n;
+        }
+    }
+done:
+    free(list);FreeEnvironmentStringsW(parent);return out;
+}
+
+int sh_external_launch(const struct sh_api *api, const struct sh_observer *o, int32_t pipe, uint32_t appid)
+{
+    /* Recheck the selected executable after authentication yielded. The App ID
+     * was already bound to the consumed handoff and checked by Valve. */
+    if (!sh_external_validate()) return 50;
+    int result = 51;
+    HANDLE job = CreateJobObjectW(NULL, NULL);
+    wchar_t *environment = child_environment(appid);
+    PROCESS_INFORMATION child = {0};
+    STARTUPINFOW startup = {.cb = sizeof(startup)};
+    JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits = {0};
+    limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+    if (!job || !environment || !SetInformationJobObject(job, JobObjectExtendedLimitInformation, &limits, sizeof(limits))) goto done;
+    if (!CreateProcessW(program, command, NULL, NULL, FALSE,
+                        CREATE_SUSPENDED | CREATE_UNICODE_ENVIRONMENT, environment, directory, &startup, &child)) goto done;
+    if (!AssignProcessToJobObject(job, child.hProcess) || ResumeThread(child.hThread) == (DWORD)-1) {
+        TerminateProcess(child.hProcess, 1);goto done;
+    }
+    o->event("external-process-started", 1);
+    result = 52;
+    for (;;) {
+        for (unsigned batch = 0; batch < 64; ++batch) {
+            struct sh_callback cb = {0};
+            if (!api->get_callback(pipe, &cb)) break;
+            bool valid = cb.id > 0 && cb.size >= 0 && (!cb.size || cb.data);
+            api->free_callback(pipe);
+            if (!valid) { result = SH_CALLBACK_INVALID;goto done; }
+        }
+        JOBOBJECT_BASIC_ACCOUNTING_INFORMATION accounting = {0};
+        if (!QueryInformationJobObject(job, JobObjectBasicAccountingInformation, &accounting, sizeof(accounting), NULL)) goto done;
+        if (!accounting.ActiveProcesses) {
+            DWORD status;
+            if (!GetExitCodeProcess(child.hProcess, &status)) goto done;
+            o->event("external-process-exit", (int32_t)status);
+            result = status ? 53 : 0;break;
+        }
+        o->sleep_ms(20);
+    }
+done:
+    if (result) o->event("external-launch-error", (int32_t)GetLastError());
+    if (child.hThread) CloseHandle(child.hThread);
+    if (child.hProcess) CloseHandle(child.hProcess);
+    if (job) CloseHandle(job);
+    free(environment);return result;
+}
