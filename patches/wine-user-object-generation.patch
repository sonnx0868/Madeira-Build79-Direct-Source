+++ b/dlls/win32u/window.c
@@ -37,7 +37,43 @@
 #define USER_HANDLE_TO_INDEX(hwnd) ((LOWORD(hwnd) - FIRST_USER_HANDLE) >> 1)
 #define USER_HANDLE_FROM_INDEX(index, generation) UlongToHandle( (index << 1) + FIRST_USER_HANDLE + (generation << 16) )
 
-static void *client_objects[MAX_USER_HANDLES];
+/* iOS shares this Unix library across Wine pseudo-processes. The server can
+ * recycle a slot after an owner exits while a client pointer remains here.
+ * Never pair a new server generation with that old pointer. All accesses to
+ * these records are protected by user_lock, including allocation publication. */
+struct client_user_object
+{
+    void *ptr;
+    HANDLE handle;
+    DWORD pid;
+    unsigned short type;
+};
+static struct client_user_object client_objects[MAX_USER_HANDLES];
+
+static void publish_client_user_object( UINT index, HANDLE handle, unsigned short type, void *ptr )
+{
+    client_objects[index].ptr = ptr;
+    client_objects[index].handle = ptr ? handle : NULL;
+    client_objects[index].pid = ptr ? GetCurrentProcessId() : 0;
+    client_objects[index].type = ptr ? type : 0;
+}
+
+static void *find_client_user_object( UINT index, HANDLE handle, unsigned short type )
+{
+    const struct client_user_object *object = &client_objects[index];
+    static unsigned int reported;
+
+    if (!object->ptr) return NULL;
+    if (object->handle == handle && object->pid == GetCurrentProcessId() && object->type == type)
+        return object->ptr;
+
+    if (reported++ < 32)
+        ERR( "user-object-generation-v1 slot=%u requested=%p stored=%p type=%u/%u pid=%04x/%04x stale pointer rejected\n",
+             index, handle, object->handle, type, object->type, GetCurrentProcessId(), object->pid );
+    /* A server-owned window can still be queried via the existing remote /
+     * desktop paths; it must not be painted or destroyed through this slot. */
+    return type == NTUSER_OBJ_WINDOW ? OBJ_OTHER_PROCESS : NULL;
+}
 
 #define SWP_AGG_NOGEOMETRYCHANGE \
