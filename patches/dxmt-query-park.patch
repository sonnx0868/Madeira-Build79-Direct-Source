diff --git a/src/dxmt/dxmt_command_queue.hpp b/src/dxmt/dxmt_command_queue.hpp
--- a/src/dxmt/dxmt_command_queue.hpp
+++ b/src/dxmt/dxmt_command_queue.hpp
@@ -264,6 +264,14 @@
     return event.signaledValue();
   };
 
+  // A bounded, event-driven alternative to millions of GetData retries.
+  // Metal returns as soon as this exact GPU event value is signaled; a
+  // timeout leaves the query pending. Never claims completion itself.
+  void WaitEventSlice(uint64_t value) {
+    if (event.signaledValue() < value)
+      event.waitUntilSignaledValue(value, 1); // maximum one millisecond
+  }
+
   obj_handle_t GetSharedEventListener() {
     return shared_event_listener;
   }
