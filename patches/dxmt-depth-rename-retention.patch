+RenamableTexturePool::getNext(uint64_t frame, uint64_t coherent_seq) {
   if (frame > last_frame_) {
+    // A scene-loading burst can fill all 32 backing slots. Keep that active
+    // capacity, but release the pool's references to long-idle, completed tail
+    // slots. Use the allocation's last actual encoded use, not merely the last
+    // clear: draws can still reference the selected backing after a rename.
+    // Outstanding command chunks and the texture's current name retain their
+    // own references. This loop neither waits for the GPU nor changes content.
+    for (size_t i = madeira::depth_rename_warm_slots; i < allocations_.size(); ++i) {
+      auto &allocation = allocations_[i];
+      if (allocation && madeira::retire_depth_rename_slot(i, allocation->lastRetainedSeqId(), coherent_seq))
+        allocation = nullptr;
+    }
     last_frame_ = frame;
     current_index_ = 0;
   }
