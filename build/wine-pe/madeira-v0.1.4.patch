+
+static struct list *get_pointer_list(void)
+{
+    struct user_thread_info *thread_info = get_user_thread_info();
+
+    /* Win32ClientInfo is zero-filled. This fork predates Wine's explicit
+     * per-thread constructor, so initialise the new list on first use. */
+    if (!thread_info->known_pointers.next) list_init( &thread_info->known_pointers );
+    return &thread_info->known_pointers;
+}
+
+static struct pointer_state *find_pointer_state( UINT32 id )
+{
+    struct pointer_state *pointer;
+    struct list *list = get_pointer_list();
+
+    LIST_FOR_EACH_ENTRY( pointer, list, struct pointer_state, entry )
+        if (pointer->id == id) return pointer;
+    return NULL;
+}
+
+static struct pointer_state *create_pointer_state( UINT32 id, POINTER_INPUT_TYPE type )
+{
+    struct pointer_state *pointer;
+
+    if (!(pointer = calloc( 1, sizeof(*pointer) ))) return NULL;
+    pointer->id = id;
+    pointer->type = type;
+    list_add_tail( get_pointer_list(), &pointer->entry );
+    return pointer;
+}
+
+static POINTER_BUTTON_CHANGE_TYPE pointer_button_change( const POINTER_INFO *old, const POINTER_INFO *new )
+{
+    static const struct
+    {
+        POINTER_FLAGS flag;
+        POINTER_BUTTON_CHANGE_TYPE down, up;
+    } buttons[] =
+    {
+        { POINTER_FLAG_FIRSTBUTTON, POINTER_CHANGE_FIRSTBUTTON_DOWN, POINTER_CHANGE_FIRSTBUTTON_UP },
+        { POINTER_FLAG_SECONDBUTTON, POINTER_CHANGE_SECONDBUTTON_DOWN, POINTER_CHANGE_SECONDBUTTON_UP },
+        { POINTER_FLAG_THIRDBUTTON, POINTER_CHANGE_THIRDBUTTON_DOWN, POINTER_CHANGE_THIRDBUTTON_UP },
+        { POINTER_FLAG_FOURTHBUTTON, POINTER_CHANGE_FOURTHBUTTON_DOWN, POINTER_CHANGE_FOURTHBUTTON_UP },
+        { POINTER_FLAG_FIFTHBUTTON, POINTER_CHANGE_FIFTHBUTTON_DOWN, POINTER_CHANGE_FIFTHBUTTON_UP },
+    };
+    POINTER_FLAGS down = ~old->pointerFlags & new->pointerFlags;
+    POINTER_FLAGS up = old->pointerFlags & ~new->pointerFlags;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(buttons); i++)
+    {
+        if (down & buttons[i].flag) return buttons[i].down;
+        if (up & buttons[i].flag) return buttons[i].up;
+    }
+    return POINTER_CHANGE_NONE;
+}
+
+void update_pointer_from_msg( POINTER_INPUT_TYPE type, const MSG *msg )
+{
+    UINT32 id = GET_POINTERID_WPARAM( msg->wParam );
+    struct pointer_state *pointer;
+    LARGE_INTEGER counter;
+    POINT location = { (SHORT)LOWORD(msg->lParam), (SHORT)HIWORD(msg->lParam) };
+    UINT dpi = get_system_dpi();
+    POINTER_INFO info;
+
+    if (!id) return;
+    if (!(pointer = find_pointer_state( id )) && !(pointer = create_pointer_state( id, type ))) return;
+
+    memset( &info, 0, sizeof(info) );
+    info.pointerType = pointer->type;
+    info.pointerId = id;
+    info.frameId = InterlockedIncrement( &last_pointer_frame );
+    info.pointerFlags = HIWORD( msg->wParam );
+    if (msg->message == WM_POINTERUPDATE) info.pointerFlags |= POINTER_FLAG_UPDATE;
+    else if (msg->message == WM_POINTERDOWN) info.pointerFlags |= POINTER_FLAG_DOWN;
+    else if (msg->message == WM_POINTERUP) info.pointerFlags |= POINTER_FLAG_UP;
+    info.sourceDevice = INVALID_HANDLE_VALUE;
+    info.hwndTarget = msg->hwnd;
+    info.ptPixelLocation = info.ptPixelLocationRaw = location;
+    if (!dpi) dpi = USER_DEFAULT_SCREEN_DPI;
+    info.ptHimetricLocation.x = location.x * 2540 / dpi;
+    info.ptHimetricLocation.y = location.y * 2540 / dpi;
+    info.ptHimetricLocationRaw = info.ptHimetricLocation;
+    info.dwTime = msg->time ? msg->time : NtGetTickCount();
+    info.historyCount = 1;
+    NtQueryPerformanceCounter( &counter, NULL );
+    info.PerformanceCount = counter.QuadPart;
+    info.ButtonChangeType = pointer_button_change( &pointer->info, &info );
+    pointer->info = info;
+}
+
+void destroy_thread_pointers(void)
+{
+    struct user_thread_info *thread_info = get_user_thread_info();
+    struct pointer_state *pointer, *next;
+
+    if (!thread_info->known_pointers.next) return;
+    LIST_FOR_EACH_ENTRY_SAFE( pointer, next, &thread_info->known_pointers, struct pointer_state, entry )
+    {
+        list_remove( &pointer->entry );
+        free( pointer );
+    }
+    list_init( &thread_info->known_pointers );
 }
 
