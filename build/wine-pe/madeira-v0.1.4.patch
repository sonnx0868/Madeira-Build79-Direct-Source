--- a/dlls/wintypes/buffer.c
+++ b/dlls/wintypes/buffer.c
@@ -23,6 +23,19 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(wintypes);
 
+/* The full Windows IBuffer marshal-by-value object is not implemented yet,
+ * but an ordinary HRESULT failure is safe for callers to handle. A Wine spec
+ * `stub` raises EXCEPTION_WINE_STUB instead, so merely probing this API can
+ * terminate a modern Unity process after the loader has successfully resolved
+ * api-ms-win-core-winrt-robuffer-l1-1-0. */
+HRESULT WINAPI RoGetBufferMarshaler( IMarshal **marshaler )
+{
+    FIXME( "marshaler %p: IBuffer marshaling is not implemented.\n", marshaler );
+    if (!marshaler) return E_POINTER;
+    *marshaler = NULL;
+    return E_NOTIMPL;
+}
+
 struct buffer_factory_statics
 {
     IActivationFactory IActivationFactory_iface;
