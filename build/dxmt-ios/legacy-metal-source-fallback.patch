diff --git a/src/dxmt/dxmt_command.cpp b/src/dxmt/dxmt_command.cpp
--- a/src/dxmt/dxmt_command.cpp
+++ b/src/dxmt/dxmt_command.cpp
@@ -4,6 +4,12 @@
 #include "dxmt_format.hpp"
 
 #include "dxmt_command.h"
+#include "dxmt_command_source.h"
+
+extern "C" uint64_t madeira_mtl_new_library_source(uint64_t device_handle,
+                                                    const char *source,
+                                                    uint64_t source_length,
+                                                    uint64_t *error_out);
 
 #include <cfloat>
 #define CREATE_PIPELINE(name)                                                                                          \
@@ -16,7 +22,26 @@ InternalCommandLibrary::InternalCommandLibrary(WMT::Device device) {
   library_ = device.newLibrary(dxmt_command, dxmt_command_len, error);
 
